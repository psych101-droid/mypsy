# MyPsych environment variables
# Copy to .env.local for local development. In production, set these in
# Vercel (Project → Settings → Environment Variables). Never commit real keys.

# --- Supabase (Project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Used for ingestion + webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (dash.voyageai.com → API keys) ---
VOYAGE_API_KEY=

# --- Stripe (dashboard.stripe.com — use test-mode keys until launch) ---
STRIPE_SECRET_KEY=
# From Developers → Webhooks after creating the webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the MyPsych product ($9.99/month and $79/year).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret protecting the cron endpoints (RSS poll, re-crawl, weekly insights).
CRON_SECRET=
